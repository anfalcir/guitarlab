{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gbw.local/schemas/result-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "jobId",
    "uid",
    "projectId",
    "inputSha256",
    "engine",
    "engineRevision",
    "model",
    "modelSha256",
    "sampleRate",
    "channels",
    "frames",
    "duration",
    "startedAt",
    "completedAt",
    "wallTimeMs",
    "vCPU",
    "blasThreads",
    "demucsThreads",
    "inferenceStrategy",
    "referenceRecipe",
    "deliverables"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "jobId": { "type": "string", "format": "uuid" },
    "uid": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "format": "uuid" },
    "inputSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "engine": { "const": "demucs.cpp" },
    "engineRevision": { "type": "string" },
    "model": { "const": "htdemucs_6s" },
    "modelSha256": { "const": "09704f4ceae204e56e77d5eefd6ac71d7275be81fd507e6913371d59abcee856" },
    "sampleRate": { "const": 44100 },
    "channels": { "const": 2 },
    "frames": { "type": "integer", "minimum": 1 },
    "duration": { "type": "number", "exclusiveMinimum": 0 },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "wallTimeMs": { "type": "integer", "minimum": 0 },
    "vCPU": { "const": 8 },
    "blasThreads": { "const": 8 },
    "demucsThreads": { "const": 0 },
    "inferenceStrategy": { "const": "single8" },
    "referenceRecipe": { "$ref": "#/$defs/referenceRecipe" },
    "deliverables": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/deliverable" }
    }
  },
  "$defs": {
    "referenceRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "targetPeakDbfs",
        "sharedGainDb",
        "backingStems",
        "guitarStem"
      ],
      "properties": {
        "version": { "const": "prepared-reference-v2" },
        "targetPeakDbfs": { "const": -1.0 },
        "sharedGainDb": { "type": "number", "maximum": 0.0 },
        "backingStems": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": ["drums", "bass", "other", "vocals", "piano"]
          }
        },
        "guitarStem": { "const": "guitar" }
      }
    },
    "deliverable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role",
        "path",
        "bytes",
        "sha256",
        "sampleRate",
        "channels",
        "frames",
        "encoding"
      ],
      "properties": {
        "name": { "enum": ["backing", "guitar"] },
        "role": { "enum": ["REFERENCE_BACKING", "REFERENCE_GUITAR"] },
        "path": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 45 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sampleRate": { "const": 44100 },
        "channels": { "const": 2 },
        "frames": { "type": "integer", "minimum": 1 },
        "encoding": { "const": "FLOAT32_LE" }
      }
    }
  }
}
