+            waitForRoute(AppScreen.Options(project.id))
+            val persisted = repository.load(project.id)!!
+            repository.save(
+                persisted.copy(
+                    name = "Updated outside Studio",
+                    updatedAtEpochMs = persisted.updatedAtEpochMs + 10_000,
+                ),
