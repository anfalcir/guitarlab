+@Composable
+private fun MasterStrip(
+    minimal: Boolean,
+    gainDb: Float,
+    meter: MeterBallisticsState,
+    clipLatched: Boolean,
+    enabled: Boolean,
+    onGainPreview: (Float) -> Unit,
