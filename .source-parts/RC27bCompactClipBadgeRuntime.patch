+                    value = gainDraft,
+                    accent = accent,
+                    enabled = enabled,
+                    onValueChange = { value ->
+                        gainDraft = value
+                        onGainPreview(value)
+                    },
+                    onValueChangeFinished = { onGainCommit(gainDraft) },
+                    contentDescription = "Volume do master",
+                )
+            }
+        }
+    }
+}
