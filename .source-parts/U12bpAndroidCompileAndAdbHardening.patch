+      - name: Reset ADB server before API 36 regression
+        shell: bash
+        run: |
+          set -euo pipefail
+          adb kill-server || true
+          rm -f ~/.android/adbkey ~/.android/adbkey.pub
+          adb start-server
+          adb devices
+
       - name: Run API 36 instrumented regression
         uses: ReactiveCircus/android-emulator-runner@a421e43855164a8197daf9d8d40fe71c6996bb0d # v2.38.0
         with:
@@ -315,9 +323,24 @@ jobs:
